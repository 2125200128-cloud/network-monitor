[Unit]
Description=Network Monitor - clasificación de equipos por evidencia SNMP/CDP/LLDP (cada hora)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=@USUARIO@
Group=@USUARIO@
WorkingDirectory=@APP_DIR@
Environment=PYTHONUNBUFFERED=1 PYTHONUTF8=1
ExecStart=@APP_DIR@/.venv/bin/python -u worker/device_classifier.py --apply --loop 3600
Restart=always
RestartSec=30
UMask=0002

[Install]
WantedBy=multi-user.target
