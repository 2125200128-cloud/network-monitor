[Unit]
Description=Network Monitor - colector de los hosts ESXi por su API (CPU, memoria, sensores, VMs, datastores; cada minuto)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=@USUARIO@
Group=@USUARIO@
WorkingDirectory=@APP_DIR@
Environment=PYTHONUNBUFFERED=1 PYTHONUTF8=1
ExecStart=@APP_DIR@/.venv/bin/python -u worker/esxi_collector.py
Restart=always
RestartSec=10
UMask=0002

[Install]
WantedBy=multi-user.target
