[Unit]
Description=Network Monitor - colector SNMP de detalle (puertos, hardware, PoE, FortiGate; cada 5 min)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=@USUARIO@
Group=@USUARIO@
WorkingDirectory=@APP_DIR@
Environment=PYTHONUNBUFFERED=1 PYTHONUTF8=1
ExecStart=@APP_DIR@/.venv/bin/python -u worker/snmp_detail_collector.py
Restart=always
RestartSec=10
UMask=0002

[Install]
WantedBy=multi-user.target
