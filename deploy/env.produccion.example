APP_NAME="Network Monitor NOC"
APP_ENV=production
# OBLIGATORIO: la MISMA clave del servidor actual (Windows). Con ella se cifraron el token de Telegram,
# las contraseñas SNMPv3 y las credenciales SSH de los equipos; con otra clave no se pueden leer.
APP_KEY=
APP_DEBUG=false
APP_URL=http://@DOMINIO@

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=network_monitor
DB_USERNAME=noc_monitor
DB_PASSWORD=@DB_PASSWORD@

# Valores iniciales (Configuración en la web los reemplaza)
SNMP_COMMUNITY=public
IP_SWITCH_CORE=10.4.254.3

# Intérprete de los workers (instalar.sh crea .venv en la carpeta del proyecto)
PYTHON_PATH=@APP_DIR@/.venv/bin/python

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Con HTTPS cambiar a true
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noc@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
